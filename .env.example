# Frontend API URL (used by Vite frontend at build/runtime)
VITE_API_URL=http://localhost:3000

# Postgres connection string for production backend
# Example: postgresql://username:password@host:5432/dbname
DATABASE_URL=

# CORS allowed origins (comma-separated) for backend
ALLOWED_ORIGINS=http://localhost:5173

# Admin credentials (use strong random password in production)
ADMIN_USERNAME=abrash
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Abrash (Educator Admin)
