# Frontend API URL (used by Vite frontend at build/runtime)
VITE_API_URL=http://localhost:3000

# Postgres connection string for production backend
# Example: postgresql://username:password@host:5432/dbname
DATABASE_URL=

# CORS allowed origins (comma-separated) for backend
ALLOWED_ORIGINS=http://localhost:5173

# Admin credentials (use strong random password in production)
ADMIN_USERNAME=abrash
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Abrash (Educator Admin)

# Supabase (production) - do NOT prefix service keys with VITE_
# SUPABASE_URL and SUPABASE_SERVICE_KEY are required when deploying to Vercel
# Example SUPABASE_URL: https://xyzcompany.supabase.co
# SUPABASE_SERVICE_KEY should be the service role key (keep it secret)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
